# ~/.zshrc — interactive shell config, built on Oh My Zsh. Env + PATH live in
# ~/.zshenv so non-interactive shells get them too.

export ZSH="$HOME/.oh-my-zsh"
# Theme, plugins, and snippets live outside $ZSH so the framework can be
# reinstalled or replaced without touching them. Every *.zsh file in
# $ZSH_CUSTOM is sourced after the plugins, before the theme.
ZSH_CUSTOM="$HOME/.config/zsh/omz"
ZSH_CACHE_DIR="$HOME/.cache/oh-my-zsh"
ZSH_THEME="tide"
zstyle ':omz:update' mode disabled  # updated by chezmoi (or the machine), not by itself

plugins=(
  gitfast            # git's own completion; much faster in big repos
  fzf
  colored-man-pages
  virtualenv
  nvm
  chezmoi
  zsh-autosuggestions
  zsh-syntax-highlighting  # must be last
)

if [[ -r "$ZSH/oh-my-zsh.sh" ]]; then
  source "$ZSH/oh-my-zsh.sh"
else
  print -P "%F{yellow}Oh My Zsh not found at $ZSH (run: chezmoi init && chezmoi apply)%f"
fi

# Machine/work-specific config (untracked; see .chezmoiignore)
if [[ -r "$HOME/.zshrc.local" ]]; then source "$HOME/.zshrc.local"; fi
